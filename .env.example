# Neon pooled connection string (runtime queries)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"
# Neon direct connection string (prisma migrate) - same host without the "-pooler" suffix
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"

# --- Auth (Better Auth + Google OAuth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Set to "true" to let any Google account sign in.
# Anything else (or unset) means only AUTH_ALLOWED_EMAILS can sign in.
ISALLOWAUTH=""

# Comma-separated. Exact addresses (you@gmail.com) or whole domains (@example.com).
# Empty means nobody can sign in.
AUTH_ALLOWED_EMAILS=""
