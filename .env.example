# Neon pooled connection string (runtime queries)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"
# Neon direct connection string (prisma migrate) - same host without the "-pooler" suffix
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"
